<server>
    <!-- The CPE and Navigator 26.0.0 images ship a key.jks that cannot be opened with the keystore_password
         from server.env, so Liberty starts without HTTPS. Use a separate default keystore instead; Liberty
         creates key.p12 with a self-signed certificate on the first start. -->
    <keyStore id="defaultKeyStore" location="key.p12" type="PKCS12" password="${keystore_password}" />
</server>
